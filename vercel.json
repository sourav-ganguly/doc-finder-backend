{
    "version": 2,
    "builds": [
        {
            "src": "app/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app/main.py"
        }
    ],
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "crons": [
        {
            "path": "/api/cron/ping-doctors",
            "schedule": "0 6 * * *"
        }
    ]
}
